{
  "name": "quran-folio",
  "version": "0.4.2",
  "description": "An offline-first Quran reader for mobile and Windows.",
  "author": "Quran Folio contributors",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prepare:tts-model": "node scripts/prepare-kokoro-model.mjs",
    "eas-build-post-install": "npm run prepare:tts-model",
    "start": "expo start",
    "android": "npm run prepare:tts-model && expo run:android",
    "ios": "npm run prepare:tts-model && expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:run": "node desktop/run.mjs desktop/main.cjs",
    "desktop:build": "npm run prepare:tts-model && npm run web:build && electron-builder --win --dir",
    "desktop:package": "npm run prepare:tts-model && npm run web:build && electron-builder --win nsis --publish never",
    "desktop:package:win7": "npm run prepare:tts-model && electron-builder --win nsis --publish never -c.electronVersion=22.3.27 -c.directories.output=release-win7",
    "build:quran": "node scripts/build-quran-database.mjs",
    "verify:quran": "node scripts/verify-quran-database.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "build": {
    "appId": "com.quranfolio.app",
    "productName": "Quran Folio",
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "desktop/*.cjs",
      "assets/tts-native/models/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*",
      "dist/assets/node_modules/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/tar-stream/**/*",
      "node_modules/unbzip2-stream/**/*",
      "node_modules/b4a/**/*",
      "node_modules/bare-events/**/*",
      "node_modules/events-universal/**/*",
      "node_modules/fast-fifo/**/*",
      "node_modules/streamx/**/*",
      "node_modules/text-decoder/**/*",
      "node_modules/through/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "assets/tts-native/models/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@kesha-antonov/react-native-background-downloader": "^4.5.4",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^57.0.6",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.6",
    "expo-sharing": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "sherpa-onnx-node": "^1.13.4",
    "tar-stream": "^3.1.7",
    "unbzip2-stream": "^1.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "prettier": "^3.9.5",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  }
}
