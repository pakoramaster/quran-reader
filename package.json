{
  "name": "quran-folio",
  "version": "0.1.4",
  "description": "An offline-first Quran reader for mobile and Windows.",
  "author": "Quran Folio contributors",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "expo export --platform web",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:run": "node desktop/run.mjs desktop/main.cjs",
    "desktop:build": "npm run web:build && electron-builder --win --dir",
    "desktop:package": "npm run web:build && electron-builder --win nsis",
    "build:quran": "node scripts/build-quran-database.mjs",
    "verify:quran": "node scripts/verify-quran-database.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "build": {
    "appId": "com.quranfolio.app",
    "productName": "Quran Folio",
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/*.cjs",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/amiri": "^0.4.1",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.101.2",
    "expo": "^57.0.6",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.6",
    "expo-speech": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.2",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  }
}
