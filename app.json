{
  "expo": {
    "name": "Quran Folio",
    "slug": "quran-folio",
    "version": "0.4.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "quranfolio",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "expo-font",
      "expo-localization",
      "expo-status-bar",
      "expo-audio",
      "./plugins/withBundledTtsModel"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.quranfolio.app"
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.quranfolio.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#163F36"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "output": "single"
    }
  }
}
